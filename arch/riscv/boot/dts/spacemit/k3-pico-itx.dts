#include <dt-bindings/gpio/gpio.h>

#include "k3.dtsi"
#include "k3-pinctrl.dtsi"

/ {
	model = "SpacemiT K3 Pico-ITX";
	compatible = "spacemit,k3-pico-itx", "spacemit,k3";

	aliases {
		ethernet0 = &eth0;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0";
	};

	memory@100000000 {
		device_type = "memory";
		reg = <0x1 0x00000000 0x4 0x00000000>;
	};

	reg_aux_vcc5v: regulator-aux-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "AUX_VCC5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	pcie_vcc_3v3: regulator-pcie-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "PCIE_VCC3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * M.2 WiFi enable line (RTL8852BE on the PCIe x1 slot, port E / pcie4).
	 * rfkill-gpio drives WLAN_EN so the card powers up before PCIe link
	 * training; the radio itself enumerates as a PCI device on pcie4.
	 */
	rfkill-pcie-wlan {
		compatible = "rfkill-gpio";
		label = "rfkill-pcie-wlan";
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_cfg>;
		radio-type = "wlan";
		shutdown-gpios = <&gpio 1 3 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Bluetooth enable line (Realtek RTL8852B, BT side of the combo).
	 * The controller enumerates over USB (btusb); rfkill-gpio drives
	 * BT_EN so the radio powers up.  Per the vendor K3 Pico-ITX BSP.
	 */
	rfkill-usb-bt {
		compatible = "rfkill-gpio";
		label = "rfkill-usb-bt";
		pinctrl-names = "default";
		pinctrl-0 = <&bt_en_cfg>;
		radio-type = "bluetooth";
		shutdown-gpios = <&gpio 0 30 GPIO_ACTIVE_HIGH>;
	};
};

&i2c8 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_cfg>;
	status = "disabled";

	p1@41 {
		compatible = "spacemit,p1";
		reg = <0x41>;
		status = "disabled";
		interrupts = <64 IRQ_TYPE_LEVEL_HIGH>;
		vin1-supply = <&reg_aux_vcc5v>;
		vin2-supply = <&reg_aux_vcc5v>;
		vin3-supply = <&reg_aux_vcc5v>;
		vin4-supply = <&reg_aux_vcc5v>;
		vin5-supply = <&reg_aux_vcc5v>;
		vin6-supply = <&reg_aux_vcc5v>;
		aldoin-supply = <&reg_aux_vcc5v>;
		dldoin1-supply = <&buck4>;
		dldoin2-supply = <&buck4>;

		regulators {
			buck1: buck1 {
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck2: buck2 {
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck3: buck3 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck4: buck4 {
				regulator-min-microvolt = <2100000>;
				regulator-max-microvolt = <2100000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck5: buck5 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck6: buck6 {
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <500000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			aldo1: aldo1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			aldo2: aldo2 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			aldo3: aldo3 {
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
			};

			aldo4: aldo4 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo1: dldo1 {
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo2: dldo2 {
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo3: dldo3 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo4: dldo4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			dldo5: dldo5 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo6: dldo6 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo7: dldo7 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&eth0 {
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_rgmii_0_cfg>, <&gmac0_phy_0_cfg>;
	phy-mode = "rgmii-id";
	phy-handle = <&phy0>;
	status = "okay";

	mdio {
		phy0: phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
			reset-gpios = <&gpio 0 15 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <10000>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_0_cfg>;
	status = "okay";
};

/* No eMMC fitted on the Pico-ITX; UFS is the boot storage (see &ufshc). */
&emmc {
	status = "disabled";
};

/*
 * UFS 2.2 controller (ufshc @ 0xc0e00000) — boot storage on the Muse
 * Pico-ITX (no eMMC fitted on that variant).  The M-PHY is integrated in
 * the controller IP (no separate PHY node/handle); ufs-spacemit.ko drives
 * the M-PHY init through the controller's own MMIO.  The SoC node lives in
 * k3.dtsi; clocks/reset come from syscon_apmu.
 */
&ufshc {
	status = "okay";
};

/*
 * CMA pool for contiguous DMA allocations (gralloc/minigbm framebuffers,
 * V4L2, etc.).  512 MiB carved from DRAM, matching the vendor K3 BSP.
 */
&resmem {
	cmamem: linux,cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x0 0x20000000>;
		alloc-ranges = <0x1 0x0 0x1 0x0>;
		linux,cma-default;
	};
};

/*
 * Display pipeline (ported from the vendor K3 BSP).  The SoC-level nodes
 * live in k3.dtsi; here the board enables the external DP1 path (the eDP0
 * path stays disabled -- no eDP panel is fitted):
 *   - eDP0  (dpu0_crtc0 -> edp0): internal-panel DisplayPort
 *   - DP1   (dpu1_crtc0 -> dp1):  external DisplayPort routed to the
 *     USB-C connector (the FUSB301 Type-C controller carries USB data
 *     only; DP is driven straight from the inno-dp controller).
 *
 * The matching drivers are now in-tree, K3-gated and separate from the
 * K1 spacemit-drm.ko (HDMI): spacemit-drm-k3.ko (dpu-saturn CRTC +
 * saturn-hee/edp masters) + spacemit_inno_dp.ko (inno-edp0/inno-dp1
 * output).  The DP1 HPD pinctrl (dp1_1_cfg) is wired below; the eDP0-only
 * references (dp0_1_cfg, backlight, panel power/enable GPIOs) stay omitted
 * while that path is disabled.  Runtime scan-out and DP link-training still
 * need validation on the board.
 *
 * DP-audio (audio over the USB-C DisplayPort) is wired below via
 * sound_card_dp1: spacemit_inno_dp registers an ASoC codec ("inno-dp-audio",
 * playback-only) and dp@cac88000 carries #sound-dai-cells, so the DP is a
 * valid codec sink.  The CPU DAI is the RCPU-domain I2S "ri2s3"
 * (spacemit,k3-ri2s) fed by "adma3" (spacemit,k3-adma) and clocked by
 * syscon_rcpu_i2sctrl — all now in-tree and K3-only.  adma3 uses direct
 * hardware IRQs (no RT coprocessor / rpmsg).  Runtime audio still needs
 * validation on the board.
 */
/*
 * Display output.  The eDP0 internal-panel pipeline (dpu0_crtc0 / edp0 /
 * display_subsystem_edp0) stays disabled: no eDP panel is fitted on this
 * board.  The DP1 pipeline (enabled below) drives the external DisplayPort
 * on the USB-C connector; dpu1_crtc0 now carries
 * power-domains = <&power K3_PMU_LCD1_PWR_DOMAIN>, so the K3 RPMI genpd
 * powers the LCD1 island before the DPU driver touches its fabric-stalling
 * MMIO.
 */
&dpu0_crtc0 {
	memory-region = <&dpu_resv0>;
	status = "okay";
};

&edp0 {
	status = "okay";
};

&dpu1_crtc0 {
	memory-region = <&dpu_resv1>;
	status = "okay";
};

&dp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&dp1_1_cfg>;
	status = "okay";
};

&display_subsystem_edp0 {
	status = "okay";
};

&display_subsystem_dp1 {
	status = "okay";
};

/*
 * DP-audio: route audio over the USB-C DisplayPort (DP1).  The RCPU I2S
 * "ri2s3" is the CPU DAI, fed by the "adma3" audio DMA; the codec sink is
 * the inno-dp1 controller (ASoC codec "inno-dp-audio").  K3-only stack.
 */
&adma3 {
	status = "okay";
};

&ri2s3 {
	status = "okay";
};

&sound_card_dp1 {
	status = "okay";
};

/*
 * USB2 host port (dwc3 @ 0xc0a00000 + USB2 PHY @ 0xc0a20000).
 * Host-only; powers downstream devices from the board 5V rail.
 */
&usb2_host_u2phy {
	status = "okay";
};

&usb2_host {
	vbus-supply = <&reg_aux_vcc5v>;
	status = "okay";
};

/*
 * USB3 port A (dwc3 @ 0xcad00000): dual-role, routed to the Type-C connector.
 * Combo PHY (USB3 @ 0xcad30000/0xcad40000) also provides the Type-C
 * orientation switch; USB2 PHY @ 0xcad20000.
 */
&usb3_porta_u2phy {
	status = "okay";
};

&usb3_porta_u3phy {
	/* dual-phy (USB3 SS vs DP) + orientation select from GPIO86 (SS_SW_3V3) */
	pinctrl-names = "default";
	pinctrl-0 = <&usb30_drd_dir_0_cfg>;
	status = "okay";
};

&usb3_porta {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	monitor-vbus;
	vbus-supply = <&reg_aux_vcc5v>;
	status = "okay";
};

&porta_role_switch {
	remote-endpoint = <&fusb301_ep>;
};

/*
 * USB3 port D (dwc3 @ 0x81a00000): host-only standard Type-A port.
 * USB2 PHY @ 0x81b00000, USB3 PHY @ 0x82100000 (combo lane bit 0).
 */
&usb3_portc_u2phy {
	status = "okay";
};

&usb3_portc {
	/* Bluetooth (RTL8852BE companion). USB2 only: the M.2 E-key slot
	 * exposes no SuperSpeed pair for it, so leave usb3_portc_u3phy
	 * disabled and drop it from phys, exactly as the vendor BSP does. */
	/delete-property/ phys;
	/delete-property/ phy-names;
	phys = <&usb3_portc_u2phy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	reset-on-resume;
	status = "okay";
};

&usb3_portd_u2phy {
	status = "okay";
};

&usb3_portd_u3phy {
	status = "okay";
};

&usb3_portd {
	vbus-supply = <&reg_aux_vcc5v>;
	status = "okay";
};

/*
 * FUSB301 Type-C DRP port controller on i2c1 (USB-C connector).
 * It manages USB data role + cable orientation only; the orientation switch
 * lives in the USB3 port A combo PHY (spacemit,k3-typec-switch) and DisplayPort
 * is driven directly by inno-dp (no DP mux through the FUSB301).
 *
 * The connector's data port is wired to the USB3 port A dwc3 role switch.
 *
 * The FUSB301 INT line is GPIO 2/21 (active-low), per the vendor K3 Pico-ITX
 * BSP; without it the driver bails out with -ENODEV. &usb3_porta runs
 * dr_mode = "otg" with usb-role-switch, so the FUSB301 flips dwc3 to
 * peripheral (registers a UDC) when a host is attached -- enabling ADB.
 */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_3_cfg>;
	status = "okay";

	tcpc@25 {
		compatible = "onsemi,fusb301";
		reg = <0x25>;
		pinctrl-names = "default";
		pinctrl-0 = <&fusb301_cfg>;
		irq-gpios = <&gpio 2 21 GPIO_ACTIVE_LOW>;
		suspend-vbus-off;
		wakeup-source;
		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			typec-power-opmode = "default";
			pd-disable;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					fusb301_ep: endpoint {
						remote-endpoint = <&porta_role_switch>;
					};
				};
			};
		};
	};
};

&i2s1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sspa1_1_cfg>;
	status = "okay";
};

/*
 * Speaker audio: the Everest ES8326 codec sits on the secure TWSI3 bus and
 * is the sink for the "i2s1" CPU DAI above.
 */
&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_1_cfg>;
	status = "okay";

	es8326: es8326@19 {
		compatible = "everest,es8326";
		reg = <0x19>;
		#sound-dai-cells = <0>;
		interrupt-parent = <&gpio>;
		interrupts = <3 31 IRQ_TYPE_EDGE_RISING>;
		everest,mic1-src = [44];
		everest,mic2-src = [66];
		everest,jack-detect-inverted;
	};
};

&sound_card1 {
	status = "okay";
	simple-audio-card,name = "snd-es8326";
	simple-audio-card,mclk-fs = <256>;

	simple-audio-card,dai-link@0 {
		format = "i2s";
		frame-master = <&link1_cpu>;
		bitclock-master = <&link1_cpu>;

		link1_cpu: cpu {
			sound-dai = <&i2s1>;
		};

		link1_codec: codec {
			sound-dai = <&es8326>;
		};
	};
};

/*
 * PCIe port E (pcie4, x1) -> M.2 WiFi slot (Realtek RTL8852BE).  The PHY,
 * the root-port PHY/supply binding and the controller are all enabled here;
 * the SoC nodes live in k3.dtsi.  Bringing up the link needs the real board.
 */
&pcie4_phy {
	status = "okay";
};

&pcie4_port {
	phys = <&pcie4_phy>;
	vpcie3v3-supply = <&pcie_vcc_3v3>;
};

&pcie4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie4_0_cfg>;
	vpcie3v3-supply = <&pcie_vcc_3v3>;
	status = "okay";
};
