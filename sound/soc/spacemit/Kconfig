menu "SpacemiT"
	depends on COMPILE_TEST || ARCH_SPACEMIT
	depends on HAVE_CLK

config SND_SOC_K1_I2S
	tristate "K1 I2S Device Driver"
	select SND_SOC_GENERIC_DMAENGINE_PCM
	depends on DMA_CMA
	help
	  Say Y or M if you want to add support for I2S driver for
	  K1 I2S controller. The device supports up to maximum of
	  2 channels each for play and record.

config SND_SOC_K1_HDMI_AUDIO
	tristate "K1 HDMI audio"
	depends on ARCH_SPACEMIT
	depends on SPACEMIT_HDMI
	help
	  Say Y or M to add HDMI audio output on the SpacemiT K1. The audio
	  DMA (ADMA) and SSPA transmitter are driven directly; the completion
	  interrupt that the vendor stack forwards through the RCPU firmware
	  is replaced by polling the DMA position.

config SND_SOC_K3_RI2S
	tristate "K3 RI2S Device Driver"
	select SND_SOC_GENERIC_DMAENGINE_PCM
	help
	  Say Y or M to add support for the RI2S ASoC CPU DAI on the
	  SpacemiT K3 SoC. The RI2S controllers live in the RCPU audio
	  domain and feed audio through the ADMA cyclic DMA engine; on
	  the Muse Pico-ITX the ri2s3 instance carries DisplayPort audio
	  to the inno-dp-audio codec.

endmenu
